PORT=4111 # HTTP port used by Mastra; Railway may override it
DATABASE_URL=postgresql://postgres:password@localhost:5432/mastra # PostgreSQL persistence connection URL

MODEL_PROVIDER=openai # AI provider: openai, anthropic, or google
MODEL_NAME=gpt-4o-mini # Provider-specific model name (without the provider prefix)

OPENAI_API_KEY= # Required only when MODEL_PROVIDER=openai
ANTHROPIC_API_KEY= # Required only when MODEL_PROVIDER=anthropic
GOOGLE_GENERATIVE_AI_API_KEY= # Required only when MODEL_PROVIDER=google

SYSTEM_PROMPT=You are a helpful AI assistant. # Default agent instructions
NODE_ENV=production # Run Mastra in production mode
